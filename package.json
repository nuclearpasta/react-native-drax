{
  "name": "react-native-drax",
  "version": "1.1.0",
  "description": "A drag and drop system for React Native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "example": "yarn workspace react-native-drax-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc && tsc --project example/tsconfig.json",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "test:docs-site": "node docs-site/scripts/check-not-found-route.cjs && node docs-site/scripts/check-docs-home-url.cjs && node docs-site/scripts/check-stalled-navigation.cjs",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "drag-and-drop",
    "sortable",
    "reorderable",
    "drag",
    "drop",
    "reanimated",
    "gesture-handler",
    "ios",
    "android",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuclearpasta/react-native-drax.git"
  },
  "author": "Joe Lafiosca <joe@proxi.gg> (https://github.com/lafiosca)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nuclearpasta/react-native-drax/issues"
  },
  "homepage": "https://nuclearpasta.com/react-native-drax",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19",
    "commitlint": "^21.2.4",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.40.13",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-worklets": "0.13.0",
    "react-test-renderer": "19.3.0",
    "release-it": "^20.2.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": "^4.0.0",
    "react-native-worklets": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "react-native-worklets": {
      "optional": true
    }
  },
  "workspaces": [
    "example",
    "docs-site"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.56.0"
  },
  "resolutions": {
    "@eslint/config-array/minimatch": "3.1.5",
    "@eslint/eslintrc/js-yaml": "4.3.2",
    "@eslint/eslintrc/minimatch": "3.1.5",
    "@expo/cli/picomatch": "4.0.7",
    "@expo/cli/ws": "8.21.0",
    "@expo/config-plugins/tinyglobby": "0.2.17",
    "@expo/mcp-tunnel/ws": "8.21.0",
    "@expo/metro-config/picomatch": "4.0.7",
    "@expo/metro-config/tinyglobby": "0.2.17",
    "@modelcontextprotocol/sdk@npm:^1.17.5": "1.32.0",
    "@react-native/codegen/tinyglobby": "0.2.17",
    "@typescript-eslint/typescript-estree/minimatch": "9.0.7",
    "@typescript-eslint/typescript-estree/tinyglobby": "0.2.17",
    "@xmldom/xmldom@npm:^0.8.8": "0.8.15",
    "basic-ftp@npm:^5.0.2": "5.3.1",
    "body-parser@npm:^2.2.1": "2.4.0",
    "brace-expansion@npm:^2.0.1": "2.1.6",
    "brace-expansion@npm:^5.0.2": "5.0.11",
    "eslint-plugin-react-hooks/zod": "4.6.6",
    "eslint-plugin-react/minimatch": "3.1.5",
    "eslint/minimatch": "3.1.5",
    "expo-mcp/ws": "8.21.0",
    "express-rate-limit/ip-address": "10.3.1",
    "minimatch@npm:^3.0.4": "3.1.5",
    "minimatch@npm:^3.1.1": "3.1.5",
    "minimatch@npm:^3.1.2": "3.1.5",
    "minimatch@npm:^9.0.4": "9.0.7",
    "path-to-regexp@npm:^8.0.0": "8.4.0",
    "picomatch@npm:^4.0.2": "4.0.7",
    "react-devtools-core/shell-quote": "1.11.0",
    "react-native/tinyglobby": "0.2.17",
    "release-it/tinyglobby": "0.2.17",
    "release-it/undici": "6.29.1"
  }
}
